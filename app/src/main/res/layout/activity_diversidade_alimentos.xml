<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray">

    <!-- Barra superior -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_toolbar"
        app:elevation="@dimen/appbar_elevation" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout style="@style/LinearContainer">

            <androidx.cardview.widget.CardView style="@style/CardNutrir">

                <LinearLayout style="@style/CardContent">

                    <!-- Título -->
                    <TextView
                        style="@style/TextTitle"
                        android:text="Diversidade dos alimentos" />

                    <!-- Texto 1 -->
                    <TextView
                        style="@style/TextBody"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="Estes devem ser &lt;b&gt;amassados com o garfo&lt;/b&gt;, e desde o início devem ser &lt;b&gt;oferecidos de colher&lt;/b&gt;, iniciando com uma consistência pastosa (papas/purês) e, gradativamente, aumentar a consistência até chegar à alimentação da família." />

                    <!-- Texto 2 -->
                    <TextView
                        style="@style/TextBody"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="É importante lembrar que &lt;b&gt;não se deve misturar os alimentos&lt;/b&gt;, para que assim a criança possa conhecer o gosto de cada alimento." />

                    <!-- Imagem / Ilustração -->
                    <ImageView
                        style="@style/ImageCenter"
                        android:src="@drawable/boiled_egg"
                        android:contentDescription="Ilustração de ovo" />

                    <!-- Card de dica (menta) -->
                    <LinearLayout style="@style/TipBoxMint">

                        <TextView
                            style="@style/TipTextMint"
                            android:text="A introdução do &lt;b&gt;ovo cozido&lt;/b&gt; (clara e gema) pode ser introduzido ao completar &lt;b&gt;6 meses&lt;/b&gt;, mas é importante considerar a &lt;b&gt;história familiar de alergias alimentares&lt;/b&gt;." />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>