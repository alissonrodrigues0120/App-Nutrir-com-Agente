<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_white">



    <!-- Conteúdo rolável -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Benefícios para a criança"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:text="O aleitamento materno &lt;b&gt;evita&lt;/b&gt; diarréia, infecções respiratórias, &lt;b&gt;diminui&lt;/b&gt; os riscos de alergias, de hipertensão arterial, colesterol alto e diabetes. Além disso, &lt;b&gt;reduz&lt;/b&gt; a chance de obesidade com uma melhor nutrição." />

            <ImageView
                android:id="@+id/imgBebe"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginTop="24dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/bebe_feliz"
                android:contentDescription="Ilustração de bebê" />

            <!-- Card de dica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_tip_mint"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tip_mint_text"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:text="Você sabia que o &lt;b&gt;aleitamento materno&lt;/b&gt; tem efeitos &lt;b&gt;positivos&lt;/b&gt; na inteligência e no desenvolvimento da cavidade bucal?" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
