<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_toolbar"
        app:elevation="@dimen/appbar_elevation" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout style="@style/LinearContainer">

            <androidx.cardview.widget.CardView style="@style/CardNutrir">

                <LinearLayout style="@style/CardContent">

                    <TextView
                        android:id="@+id/tv_title"
                        style="@style/TextTitleLarge"
                        android:layout_width="match_parent"
                        android:text="Calendário de Puericultura" />

                    <TextView
                        android:id="@+id/tv_subtitle"
                        style="@style/TextBody"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textColor="@color/text_secondary"
                        android:text="O Ministério da Saúde recomenda cinco consultas de rotina nos primeiro 6 meses de vida:" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_lg"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ListItemTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• 12º mês de vida." />

                        <TextView
                            style="@style/ListItemTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• 18º mês de vida." />

                        <TextView
                            style="@style/ListItemTextStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• 24º mês de vida." />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_doctor"
                        android:layout_width="@dimen/image_size_sm"
                        android:layout_height="@dimen/image_size_sm"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_xxl"
                        android:contentDescription="@string/profissional_da_saude"
                        android:src="@drawable/enfermeira_1"
                        app:srcCompat="@drawable/enfermeira_1" />

                    <androidx.cardview.widget.CardView
                        style="@style/CalloutCard"
                        android:layout_marginTop="@dimen/spacing_xxl"
                        app:cardBackgroundColor="@color/warn_orange">

                        <TextView
                            style="@style/AlertTextOrange"
                            android:textColor="@color/color_text_black"
                            android:textSize="@dimen/text_size_lg"
                            android:textStyle="normal"
                            android:text="@string/puericultura_1" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>