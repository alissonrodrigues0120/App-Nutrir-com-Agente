<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray">

    <!-- Barra superior -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_toolbar"
        app:elevation="@dimen/appbar_elevation" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            style="@style/LinearContainer">

            <androidx.cardview.widget.CardView
                style="@style/CardNutrir">

                <LinearLayout
                    style="@style/CardContent">

                    <!-- Título -->
                    <TextView
                        style="@style/TextTitle"
                        android:text="Benefícios para a mãe" />

                    <!-- Texto 1 -->
                    <TextView
                        style="@style/TextBody"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="O aleitamento materno protege a mãe contra inúmeras doenças como:" />

                    <!-- Lista de Benefícios (Bullets) -->
                    <TextView
                        style="@style/TextBody"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="&#8226; Câncer de mama, útero e de ovário;\n&#8226; Obesidade, depressão pós-parto, aumento do colesterol, aumento da pressão arterial, dentre outras." />

                    <!-- Texto 2 -->
                    <TextView
                        style="@style/TextBody"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="Além disso, promove um melhor vínculo afetivo entre mãe e filho, melhorando a qualidade de vida de ambos." />

                    <!-- Imagem / Ilustração -->
                    <ImageView
                        style="@style/ImageCenter"
                        android:src="@drawable/beneficios_para_mae"
                        android:contentDescription="Ilustração de mãe amamentando" />

                    <!-- Card de dica (menta) -->
                    <LinearLayout
                        style="@style/TipBoxMint">

                        <TextView
                            style="@style/TipTextMint"
                            android:text="@string/benef_mae" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>