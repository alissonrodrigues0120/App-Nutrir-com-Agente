<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_toolbar"
        app:elevation="@dimen/appbar_elevation" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout style="@style/LinearContainer">

            <androidx.cardview.widget.CardView style="@style/CardNutrir">

                <LinearLayout style="@style/CardContent">

                    <!-- Título -->
                    <TextView
                        style="@style/TextTitle"
                        android:text="@string/scheme_title_7_11" />

                    <!-- Intro text -->
                    <TextView
                        style="@style/TextBodySmall"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="@string/intro_text_7_11" />

                    <!-- Items list -->
                    <TextView
                        style="@style/TextBodySmall"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="@string/items_list_7_11" />

                    <!-- Illustration -->
                    <ImageView
                        android:layout_width="@dimen/image_size_xs"
                        android:layout_height="@dimen/image_size_xs"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:contentDescription="@string/img_desc"
                        android:src="@drawable/pure_batata" />

                    <!-- Blue card -->
                    <LinearLayout style="@style/SchemeBoxBlue">

                        <TextView
                            style="@style/SchemeTitle"
                            android:text="@string/blue_card_title" />

                        <TextView
                            style="@style/TextBodySmall"
                            android:text="@string/blue_card_text_7_11" />

                        <TextView
                            style="@style/TextBodySmall"
                            android:text="@string/blue_card_text_7_112" />
                    </LinearLayout>

                    <!-- Yellow card -->
                    <LinearLayout style="@style/SchemeBoxYellow">

                        <TextView
                            style="@style/SchemeTitle"
                            android:text="@string/yellow_card_title" />

                        <TextView
                            style="@style/TextBodySmall"
                            android:text="@string/text7m" />
                    </LinearLayout>

                    <!-- Cyan card -->
                    <LinearLayout style="@style/SchemeBoxCyan">

                        <TextView
                            style="@style/SchemeTitle"
                            android:text="@string/cian_card_title7m" />

                        <TextView
                            style="@style/SchemeSubtitle"
                            android:text="7 a 8 meses" />

                        <TextView
                            style="@style/TextBodySmall"
                            android:text="Ofereça alimentos menos amassados do que antes ou bem picados, de acordo com a aceitação da criança." />

                        <TextView
                            style="@style/SchemeSubtitle"
                            android:text="9 a 11 meses" />

                        <TextView
                            style="@style/TextBodySmall"
                            android:text="A criança já pode receber alimentos picados na mesma consistência dos alimentos da família. As carnes podem ser desfiadas." />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>