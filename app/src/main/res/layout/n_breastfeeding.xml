<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_toolbar"
        app:elevation="@dimen/appbar_elevation" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout style="@style/LinearContainer">

            <androidx.cardview.widget.CardView style="@style/CardNutrir">

                <LinearLayout style="@style/CardContent">

                    <!-- Título da página -->
                    <TextView
                        android:id="@+id/tvTitulo"
                        style="@style/TextTitle"
                        android:text="Número de mamadas ao dia" />

                    <!-- Texto principal -->
                    <TextView
                        android:id="@+id/tvTextoPrincipal1"
                        style="@style/TextBody"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="@string/mamadatext" />

                    <TextView
                        android:id="@+id/tvTextoPrincipal2"
                        style="@style/TextBody"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="@string/mamadatext2" />

                    <!-- Texto secundário -->
                    <TextView
                        android:id="@+id/tvTextoSecundario1"
                        style="@style/TextBody"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:text="@string/mamadatext3" />

                    <!-- Card com fundo azul claro -->
                    <LinearLayout
                        android:id="@+id/cardCapacidadeGastrica1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/info_cyan"
                        android:padding="@dimen/padding_lg"
                        android:layout_marginBottom="@dimen/spacing_xl"
                        android:elevation="@dimen/elevation_sm">

                        <TextView
                            android:id="@+id/tvCardTitulo"
                            style="@style/TextBoxTitle"
                            android:text="Veja a seguir a capacidade gástrica da criança no seu primeiro mês de vida" />

                        <TextView
                            android:id="@+id/tvCardLista1"
                            style="@style/TextBodySmall"
                            android:layout_width="wrap_content"
                            android:textSize="@dimen/text_size_body_small"
                            android:text="@string/mamadatext41" />

                        <TextView
                            android:id="@+id/tvCardLista2"
                            style="@style/TextBodySmall"
                            android:layout_width="wrap_content"
                            android:textSize="@dimen/text_size_body_small"
                            android:text="@string/mamadatext42" />

                        <TextView
                            android:id="@+id/tvCardLista3"
                            style="@style/TextBodySmall"
                            android:layout_width="wrap_content"
                            android:textSize="@dimen/text_size_body_small"
                            android:text="@string/mamadatext43" />

                        <TextView
                            android:id="@+id/tvCardLista4"
                            style="@style/TextBodySmall"
                            android:layout_width="wrap_content"
                            android:textSize="@dimen/text_size_body_small"
                            android:text="@string/mamadatext44" />

                        <!-- Ícone do estômago -->
                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottieEstomago"
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:layout_gravity="center"
                            app:lottie_rawRes="@raw/ic_estomago"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>