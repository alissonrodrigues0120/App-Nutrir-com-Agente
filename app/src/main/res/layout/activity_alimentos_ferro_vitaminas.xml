<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray">

    <!-- Barra superior -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_toolbar"
        app:elevation="12dp">

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Título -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Alimentos ricos em Ferro e Vitaminas A e C"
                        android:textColor="@android:color/black"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Parágrafo introdutório -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:text="Os alimentos são importantes fontes de ferro e vitaminas, inseri-los na dieta da criança ajudará no crescimento e desenvolvimento adequado." />

                    <!-- Alimentos ricos em Ferro -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="Alimentos ricos em Ferro:" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="12dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:text="&#8226; Carnes de gado;\n&#8226; Aves como frango ou galinha;\n&#8226; Peixes;\n&#8226; Fígado." />

                    <!-- Alimentos ricos em Vitamina A -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="Alimentos ricos em Vitamina A:" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="12dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:text="&#8226; Fígado, gema de ovo e leite de vaca;\n&#8226; Frutas e legumes amarelo-alaranjados como manga, pitanga, mamão, caqui, abóbora, cenoura e batata-doce;\n&#8226; Vegetais amarelos e vegetais folhosos verdes como espinafre, couve e brócolis;\n&#8226; Óleos e frutas oleaginosas como buriti, pupunha, dendê e pequi." />

                    <!-- Alimentos ricos em Vitamina C -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="Alimentos ricos em Vitamina C:" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="12dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:text="&#8226; Laranja, limão e abacaxi;\n&#8226; Tomate, acerola, goiaba, kiwi e manga." />

                    <!-- Parágrafo final -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:text="@string/ferro" />

                    <!-- Card de dica (menta) - vitamina D -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_tip_mint"
                        android:padding="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/tip_mint_text"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/ferro_2" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/tip_mint_text"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp"
                            android:text="Lembrando que a exposição solar deve ser cuidadosa, evitando as horas de maior intensidade (10h às 16h)." />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>