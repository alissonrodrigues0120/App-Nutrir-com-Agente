<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_toolbar"
        app:elevation="@dimen/appbar_elevation" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            style="@style/LinearContainer">

            <androidx.cardview.widget.CardView
                style="@style/CardNutrir">

                <LinearLayout
                    style="@style/CardContent">

                    <TextView
                        style="@style/TextTitleLarge"
                        android:text="Aspecto do leite" />

                    <TextView
                        style="@style/TextBodyWrap"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="O aspecto do leite varia ao longo de uma mamada e também com a dieta da mãe." />

                    <TextView
                        style="@style/TextBodyWrap"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="No início da mamada, pelo seu alto teor de água, tem aspecto semelhante ao da água de coco, porém, ele é muito rico em anticorpos." />

                    <TextView
                        style="@style/TextBodyWrap"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="No meio da mamada, tende a ter uma coloração branca opaca devido ao aumento da concentração de caseína, proteína essa que ajuda na sensação de saciedade por mais tempo, dentre outros benefícios." />

                    <TextView
                        style="@style/TextBodyWrap"
                        android:layout_marginBottom="@dimen/spacing_xxl"
                        android:text="No final da mamada, o chamado leite posterior, é mais amarelado devido a substâncias provenientes da dieta da mãe." />

                    <ImageView
                        style="@style/ImageCenter"
                        android:layout_marginBottom="@dimen/spacing_xxl"
                        android:src="@drawable/mae_e_bebe"
                        android:contentDescription="Ilustração de mãe amamentando bebê" />

                    <LinearLayout style="@style/AlertBoxLavender">

                        <TextView
                            style="@style/AlertTextLavender"
                            android:text="O leite pode ter aspecto azulado ou esverdeado quando a mãe ingere grande quantidade de vegetais verdes e isto não interfere na qualidade do leite." />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>