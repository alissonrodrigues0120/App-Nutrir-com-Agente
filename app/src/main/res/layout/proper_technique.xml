<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_toolbar"
        app:elevation="@dimen/appbar_elevation" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout style="@style/LinearContainer">

            <androidx.cardview.widget.CardView style="@style/CardNutrir">

                <LinearLayout style="@style/CardContent">

                    <!-- Título da página -->
                    <TextView
                        android:id="@+id/tvTitulo"
                        style="@style/TextTitle"
                        android:text="Técnica de amamentação" />

                    <TextView
                        android:id="@+id/tvTextoPrincipal"
                        style="@style/TextBody"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="@string/tecmamamada" />

                    <TextView
                        android:id="@+id/tv_5_TextoPrincipal"
                        style="@style/TextBody"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="A Organização Mundial da Saúde (OMS) destaca quatro pontos-chave que caracterizam o posicionamento e pega adequados:" />

                    <ImageView
                        android:id="@+id/feeding_child_image"
                        style="@style/ImageCenter"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/mae_forma_c" />

                    <LinearLayout
                        style="@style/SchemeBoxYellow"
                        android:layout_marginBottom="@dimen/spacing_md">

                        <TextView
                            android:id="@+id/tv_3_TextoPrincipal"
                            style="@style/TextBody"
                            android:gravity="center"
                            android:text="@string/tecmamada2" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_1_Titulo"
                        style="@style/TextSection"
                        android:layout_gravity="center"
                        android:text="Pontos-chave do posicionamento adequado" />

                    <TextView
                        android:id="@+id/tv_2_TextoPrincipal"
                        style="@style/TextBody"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="@string/tecmamada3" />

                    <TextView
                        android:id="@+id/tv_Titulo"
                        style="@style/TextSection"
                        android:layout_gravity="center"
                        android:text="Pontos-chave da pega adequada" />

                    <TextView
                        android:id="@+id/tv_4_TextoPrincipal"
                        style="@style/TextBody"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="@string/tecmamada4" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>